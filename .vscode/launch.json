{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Predict One Image",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/predict_image.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "USAGI_QUERY_IMAGE": "${input:queryImage}",
        "USAGI_DEVICE": "auto",
        "USAGI_LATENCY_WARMUP": "0",
        "USAGI_LATENCY_RUNS": "0"
      }
    },
    {
      "name": "Benchmark One Image",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/predict_image.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "USAGI_QUERY_IMAGE": "${input:queryImage}",
        "USAGI_DEVICE": "auto",
        "USAGI_LATENCY_WARMUP": "3",
        "USAGI_LATENCY_RUNS": "20"
      }
    },
    {
      "name": "Compare Retrieval Aggregations",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/compare_aggregations.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "USAGI_GALLERY_SPLIT": "train",
        "USAGI_QUERY_SPLIT": "train",
        "USAGI_TOP_K_MEAN": "3",
        "USAGI_WEIGHTED_NEIGHBORS": "5",
        "USAGI_VOTE_TEMPERATURE": "0.07"
      }
    },
    {
      "name": "Build DINOv2 Embedding Baseline",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/build_embedding_baseline.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "USAGI_DEVICE": "auto",
        "USAGI_BATCH_SIZE": "8",
        "USAGI_EMBEDDING_SPLITS": "train,validation",
        "USAGI_ALLOW_FINAL_TEST": "false"
      }
    },
    {
      "name": "Prepare Session 1",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/prepare_data.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "USAGI_SESSION": "session-001",
        "USAGI_SPLIT": "train"
      }
    },
    {
      "name": "Prepare Session 2",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/prepare_data.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "USAGI_SESSION": "session-002",
        "USAGI_SPLIT": "validation"
      }
    },
    {
      "name": "Prepare Session 3",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/prepare_data.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "USAGI_SESSION": "session-003",
        "USAGI_SPLIT": "test"
      }
    }
  ],
  "inputs": [
    {
      "id": "queryImage",
      "type": "promptString",
      "description": "Absolute path to one doll photo"
    }
  ]
}
