{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Personal Catalog API",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_catalog_app.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "USAGI_CATALOG_DB": "${workspaceFolder}/private/catalog.sqlite3"
      }
    },
    {
      "name": "Evaluate Final Known Test",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/evaluate_final_known_test.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "USAGI_DEVICE": "auto",
        "USAGI_BATCH_SIZE": "8"
      }
    },
    {
      "name": "Select Partial Fine Tuning Checkpoint",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/select_partial_finetune_checkpoint.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Evaluate Selected Partial Fine Tuning",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/evaluate_selected_partial_finetune.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "USAGI_DEVICE": "auto",
        "USAGI_BATCH_SIZE": "8",
        "USAGI_MINIMUM_KNOWN_ACCEPTANCE": "0.95"
      }
    },
    {
      "name": "Check Fine Tuning Readiness",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/check_finetune_readiness.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "args": [
        "--config",
        "configs/partial_finetune/conservative.json"
      ]
    },
    {
      "name": "Smoke Test Partial Fine Tuning",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/train_partial_finetune.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "args": [
        "--config",
        "configs/partial_finetune/smoke.json",
        "--artifact-root",
        "artifacts/smoke"
      ]
    },
    {
      "name": "Train Partial Fine Tuning",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/train_partial_finetune.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "args": [
        "--config",
        "configs/partial_finetune/conservative.json"
      ]
    },
    {
      "name": "Train Linear Probe",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/train_linear_probe.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "USAGI_SEED": "42",
        "USAGI_EPOCHS": "300",
        "USAGI_BATCH_SIZE": "16",
        "USAGI_LEARNING_RATE": "0.01",
        "USAGI_WEIGHT_DECAY": "0.0001",
        "USAGI_PATIENCE": "40",
        "USAGI_MINIMUM_DELTA": "0.00001",
        "USAGI_DEVICE": "cpu"
      }
    },
    {
      "name": "Predict One Image",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/predict_image.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "USAGI_QUERY_IMAGE": "${input:queryImage}",
        "USAGI_DEVICE": "auto",
        "USAGI_LATENCY_WARMUP": "0",
        "USAGI_LATENCY_RUNS": "0"
      }
    },
    {
      "name": "Benchmark One Image",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/predict_image.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "USAGI_QUERY_IMAGE": "${input:queryImage}",
        "USAGI_DEVICE": "auto",
        "USAGI_LATENCY_WARMUP": "3",
        "USAGI_LATENCY_RUNS": "20"
      }
    },
    {
      "name": "Evaluate Unknown Rejection",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/evaluate_unknown_rejection.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "USAGI_MINIMUM_KNOWN_ACCEPTANCE": "0.95"
      }
    },
    {
      "name": "Compare Retrieval Aggregations",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/compare_aggregations.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "USAGI_GALLERY_SPLIT": "train",
        "USAGI_QUERY_SPLIT": "train",
        "USAGI_TOP_K_MEAN": "3",
        "USAGI_WEIGHTED_NEIGHBORS": "5",
        "USAGI_VOTE_TEMPERATURE": "0.07"
      }
    },
    {
      "name": "Build DINOv2 Embedding Baseline",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/build_embedding_baseline.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "USAGI_DEVICE": "auto",
        "USAGI_BATCH_SIZE": "8",
        "USAGI_EMBEDDING_SPLITS": "train,validation",
        "USAGI_ALLOW_FINAL_TEST": "false"
      }
    },
    {
      "name": "Prepare Session 1",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/prepare_data.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "USAGI_SESSION": "session-001",
        "USAGI_SPLIT": "train"
      }
    },
    {
      "name": "Prepare Session 2",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/prepare_data.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "USAGI_SESSION": "session-002",
        "USAGI_SPLIT": "validation"
      }
    },
    {
      "name": "Prepare Unknown Validation",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/prepare_data.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "USAGI_SESSION": "session-004",
        "USAGI_SPLIT": "validation"
      }
    },
    {
      "name": "Prepare Session 3",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/prepare_data.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "USAGI_SESSION": "session-003",
        "USAGI_SPLIT": "test"
      }
    }
  ],
  "inputs": [
    {
      "id": "queryImage",
      "type": "promptString",
      "description": "Absolute path to one doll photo"
    }
  ]
}
