{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Build DINOv2 Embedding Baseline",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/build_embedding_baseline.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "USAGI_DEVICE": "auto",
        "USAGI_BATCH_SIZE": "8"
      }
    },
    {
      "name": "Prepare Session 1",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/prepare_data.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "USAGI_SESSION": "session-001",
        "USAGI_SPLIT": "train"
      }
    },
    {
      "name": "Prepare Session 2",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/prepare_data.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "USAGI_SESSION": "session-002",
        "USAGI_SPLIT": "validation"
      }
    },
    {
      "name": "Prepare Session 3",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/prepare_data.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "USAGI_SESSION": "session-003",
        "USAGI_SPLIT": "test"
      }
    }
  ]
}
